{
  "name": "causalbench-gui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prebuild:pages": "npm run audit:production",
    "build:pages": "ng build --configuration production,pages && node tools/prepare-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:exports": "node scripts/check-exports.cjs",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@lezer/python": "1.1.18",
    "fflate": "0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "2.9.1",
    "zone.js": "~0.15.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}
